# Alchemy API key, used only as the primary RPC for mainnet ENS lookups.
# Optional: without it, ENS resolution falls back to a public mainnet RPC.
ALCHEMY_API_KEY=

# Reown (WalletConnect) project ID (required).
WALLETCONNECT_PROJECT_ID=

# DappLooker API key used for dashboard charts.
REACT_APP_DAPPLOOKER_API_KEY=

# Gnosis subgraph endpoint (HyperIndex) for registry data.
REACT_APP_SUBGRAPH_GNOSIS_ENDPOINT=https://indexer.hyperindex.xyz/[api-key]/v1/graphql

# Kleros Display Gnosis subgraph endpoint (The Graph) for policy/metadata.
REACT_APP_SUBGRAPH_KLEROS_DISPLAY_GNOSIS_ENDPOINT=https://gateway.thegraph.com/api/[api-key]/subgraphs/id/FxhLntVBELrZ4t1c2HNNvLWEYfBjpB8iKZiEymuFSPSr

# Kleros Atlas endpoint used for SIWE-authenticated IPFS uploads.
REACT_APP_ATLAS_URI=

# --- Notification service (Netlify Functions, see netlify/notify/README.md) ---
# Only needed to run `yarn notify:dev` locally or in the Netlify site settings.
# NOTIFY_DATABASE_URL=
# NOTIFY_SESSION_SECRET=
# NOTIFY_SITE_URL=http://localhost:5173
# RESEND_API_KEY=
# NOTIFY_EMAIL_FROM=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:
